# 应用基础路径。
# Vite 构建时用于生成静态资源访问前缀；默认值为 ./，适合本地文件/Tauri/相对路径部署。
# 如果部署在子目录，例如 GitHub Pages，可改为 /your-repo-name/。
VITE_BASE_URL=./

# 浏览器端工作空间 bridge 服务基础地址。
# 留空时默认走同源 /api/workspace，适合 `npm run dev` 下通过 Vite proxy 转发到本地 bridge。
# 如果前端与 bridge 分开部署，请填写完整地址，例如 http://localhost:3001。
VITE_WORKSPACE_BRIDGE_BASE_URL=

# GitHub OAuth 应用 Client ID。
# 前端用于发起 GitHub 登录，bridge 服务和 Tauri 端也会读取它完成 OAuth 配置检查。
# 未启用 GitHub 同步时可留空。
VITE_GITHUB_CLIENT_ID=

# GitHub OAuth 应用 Client Secret。
# 仅 bridge 服务和 Tauri 端在交换 access token 时使用，前端不会直接使用它。
# 未启用 GitHub 同步时可留空，但启用 GitHub 同步时必须与 Client ID 成对配置。
VITE_GITHUB_CLIENT_SECRET=

# Gitee OAuth 应用 Client ID。
# 前端用于发起 Gitee 登录，bridge 服务和 Tauri 端也会读取它完成 OAuth 配置检查。
# 未启用 Gitee 同步时可留空。
VITE_GITEE_CLIENT_ID=

# Gitee OAuth 应用 Client Secret。
# 仅 bridge 服务和 Tauri 端在交换 access token 时使用，前端不会直接使用它。
# 未启用 Gitee 同步时可留空，但启用 Gitee 同步时必须与 Client ID 成对配置。
VITE_GITEE_CLIENT_SECRET=

# ===== Bridge Server =====
# OAuth bridge 服务监听端口（server/index.js）。
OAUTH_BRIDGE_PORT=3001

# OAuth bridge 请求体大小限制。
OAUTH_BRIDGE_BODY_LIMIT=50mb

# 本地 OAuth bridge 服务端口。
# `npm run dev:bridge` / `npm run dev` 启动的 Express 服务会读取该值，默认端口为 3001。
OAUTH_BRIDGE_PORT=3001

# 本地 OAuth bridge 服务允许的请求体大小上限。
# 用于工作空间快照同步接口，默认值为 50mb；当同步内容较大时可按需调高。
OAUTH_BRIDGE_BODY_LIMIT=50mb
